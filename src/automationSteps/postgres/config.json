{
  "name": "Run Query",
  "action_description": "Connects to Postgres and executes a query",
  "plugin_description": "Postgres connector",
  "action_type": "postgres_query",
  "runtime": "python 3.12",
  "secrets": ["postgres_host", "postgres_port", "postgres_password"],
  "inputs": [{
      "name": "user",
      "label": "User",
      "data_type": "string",
      "required": true,
      "script_alias": "user"
    },
    {
      "name": "database",
      "label": "Database",
      "data_type": "string",
      "required": true,
      "script_alias": "database"
    },
    {
      "name": "query",
      "label": "Query",
      "data_type": "string",
      "required": true,
      "script_alias": "query"
    }
    ],
  "outputs": [
    {
      "name": "result",
      "label": "Result",
      "data_type": "string",
      "script_alias": "result"
    }
  ]
}
